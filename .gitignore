*.pdf
*.aux
*.out
*.toc
*.synctex.gz

# ----------------
# AI Agent Configuration (local, not shared)
# ----------------
# Tool configuration directories
/.claude/
/.gemini/
/.agents/
/.agent/
/.codex/
/.serena/

# Persistent memory / context files
/.remember
memory/

# AI agent instruction files (local overrides)
/AGENTS.md
/CLAUDE.md
/GEMINI.md

# Claude session data
.claude-sessions/
.claude-context/
.claude-progress.md
docs/.claude-progress.md
.claude/progress/

# claude-flow daemon/runtime state
.claude-flow/
claude-flow.config.json
agentdb.rvf
agentdb.rvf.*

# Agent-OS development framework (internal use)
agent-os/

# ----------------
# Graphify Knowledge Graph
# ----------------
# Ephemeral build artifacts and cache
graphify-out/cache/
graphify-out/.graphify_*.json
graphify-out/.graphify_*.txt
graphify-out/.obsidian/
graphify-out/_COMMUNITY_*.md

# ----------------
# Plugin Development
# ----------------
# Plugin testing and development artifacts
plugins/*/test-output/
plugins/*/coverage/
plugins/*/.pytest_cache/
plugins/*/node_modules/

# Draft plugins (unpublished)
plugins/draft-*/
plugins/experimental-*/
plugins/_*/

# Plugin backups
plugins/*.backup/
Backup/

# Plugin review and analysis outputs (auto-generated)
/reports/
/reviews/
.audit/
tools/maintenance/output/

# ----------------
# Documentation Build
# ----------------
# Sphinx
docs/_build/
docs/.doctrees/
docs/_static/generated/

# MkDocs
site/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# ----------------
# Personal Notes and Planning
# ----------------
NOTES.md
TODO.md
SCRATCH.md
PERSONAL.md
.notes/
drafts/

# ----------------
# CI/CD and Testing
# ----------------
.github/workflows/*.local.yml
.gitlab-ci.local.yml
test-results/
test-reports/
coverage.xml
junit.xml

# ----------------
# Git
# ----------------
*.patch
*.diff
*.orig
*.rej

# ============================================
# KEEP THESE FILES (explicit exceptions)
# ============================================
!.gitignore
!.github/
!.gitlab-ci.yml
!.markdownlint.json
!.markdown-link-check.json

# Keep plugin structure
!plugins/*/plugin.json
!plugins/*/README.md
!plugins/*/agents/
!plugins/*/commands/
!plugins/*/skills/

# Keep marketplace metadata
!.claude-plugin/
!.claude-plugin/marketplace.json

# Local git worktrees
.worktrees/
