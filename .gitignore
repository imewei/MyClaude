# ================================================
# Claude Code Plugin Marketplace — .gitignore
# ================================================

# ----------------
# Python & uv
# ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# uv package manager
.uv/

# ----------------
# Python Caches
# ----------------
.mypy_cache/
.mypy_cache.*
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
pytestdebug.log

# ----------------
# IDE & Editors
# ----------------
.vscode/
*.code-workspace
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
.*.sw[a-z]
*.un~
Session.vim

# ----------------
# OS Files
# ----------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*

# ----------------
# Logs & Temporary Files
# ----------------
*.log
*.tmp
*.bak
*.backup
.cache/
tmp/
temp/

# ----------------
# Environment & Secrets
# ----------------
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
config.local.*

# ----------------
# Documentation Build
# ----------------
docs/_build/
docs/.doctrees/
docs/_static/generated/
.ipynb_checkpoints/
*.ipynb

# ----------------
# Sphinx/Sphinx-build & Reports
# ----------------
coverage.xml
junit.xml

# ----------------
# Graphify Knowledge Graph (ephemeral)
# ----------------
graphify-out/cache/
graphify-out/.graphify_*.json
graphify-out/.graphify_*.txt
graphify-out/.obsidian/
graphify-out/_COMMUNITY_*.md
graphify-out/graph.html
graphify-out/.graphify_*.sig
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# ----------------
# Plugin Development (auto-generated)
# ----------------
plugins/*/test-output/
plugins/*/coverage/
plugins/*/.pytest_cache/
plugins/draft-*/
plugins/experimental-*/
plugins/_*/

# Backups & review outputs
Backup/
/reports/
/reviews/
.audit/
tools/maintenance/output/

# ----------------
# AI Agent Configuration (local-only)
# ----------------
/.claude/
/.gemini/
/.agents/
/.agent/
/.codex/
/.serena/
/.remember
memory/

# Agent instruction files (local overrides, not shared)
/AGENTS.md
/CLAUDE.md
/GEMINI.md

# Claude session & runtime state
.claude-sessions/
.claude-context/
.claude-progress.md
docs/.claude-progress.md
.claude/progress/
.claude-flow/
claude-flow.config.json
agentdb.rvf
agentdb.rvf.*
agent-os/

# ----------------
# CI/CD Local Files
# ----------------
.github/workflows/*.local.yml
.gitlab-ci.local.yml

# ----------------
# Git Artifacts
# ----------------
*.patch
*.diff
*.orig
*.rej

# ----------------
# Git Worktrees
# ----------------
.worktrees/

# ================================================
# KEEP THESE FILES (explicit exceptions)
# ================================================
!.gitignore
!.github/
!.gitlab-ci.yml
!.markdownlint.json
!.markdown-link-check.json
!plugins/*/plugin.json
!plugins/*/README.md
!plugins/*/agents/
!plugins/*/commands/
!plugins/*/skills/
!.claude-plugin/
!.claude-plugin/marketplace.json
