# Build artifacts & ephemeral caches
graphify-out/
docs/_build/

# Python runtime & tool caches
**/__pycache__/
**/*.pyc
**/*.pyo
.venv/
.mypy_cache/
.mypy_cache.*/
.pytest_cache/
.ruff_cache/

# Package lock (large, low context value)
uv.lock

# Data files too large for context
**/*.csv
**/*.parquet
**/*.h5
**/*.hdf5
